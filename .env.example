# Database — required. Default port 5433 (not Postgres' usual 5432) to avoid
# conflicting with a Homebrew or Postgres.app server already bound there on
# many dev machines. docker-compose.yml binds the protopen container to 5433.
DATABASE_URL=postgres://protopen:protopen@localhost:5433/protopen?sslmode=disable

# Server — set PORT for single-server production mode, leave empty for local
# split-server dev (app on APP_LISTEN_ADDR, content on CONTENT_LISTEN_ADDR).
PORT=
APP_LISTEN_ADDR=:8080
CONTENT_LISTEN_ADDR=:8081

# Origins — your protopen instance's public URLs. APP_ORIGIN and
# CONTENT_ORIGIN are the canonical hosts checked against incoming requests
# in production; leave empty in local dev. PUBLIC_CONTENT_URL is where
# live sites are served from (your wildcard subdomain or r2.dev URL).
APP_ORIGIN=
CONTENT_ORIGIN=
PUBLIC_CONTENT_URL=http://127.0.0.1:8081
FRONTEND_ORIGIN=http://localhost:5173

# Cookie domain for the protopen_session cookie. Set in production to your
# apex domain (e.g. .example.com) so the cookie spans app/content subdomains.
# Leave empty for local dev.
COOKIE_DOMAIN=

# Cloudflare R2 — empty R2_BUCKET_NAME falls back to local-filesystem
# storage at INGEST_ROOT. Set all four to use R2.
R2_BUCKET_NAME=
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=

# Local filesystem storage (used when R2 is not configured).
INGEST_ROOT=.data/ingest

# Resend (transactional email) — empty RESEND_API_KEY disables email entirely;
# auth still works (it's password-based, not magic-link). RESEND_FROM_ADDRESS
# must be a domain you've verified in Resend.
RESEND_API_KEY=
RESEND_FROM_ADDRESS=

# Comma-separated list of email addresses granted admin access in the UI.
# Default includes the seeded demo account so a SEED_DEMO=1 instance has a
# discoverable admin without extra setup. Replace with your own email(s) in
# production.
ADMIN_EMAILS=demo@protopen.dev

# Trusted proxy header for client-IP resolution in rate limiting. Leave empty
# (default) to use the connection remote-addr — correct for bare-VM
# deployments. Behind Cloudflare set CF-Connecting-IP. Behind a reverse proxy
# that strips client-supplied X-Forwarded-For set X-Forwarded-For. Only set
# this if your proxy guarantees the header is not attacker-controllable;
# otherwise clients can spoof their IP to bypass rate limits.
TRUSTED_PROXY_HEADER=

# Set to any non-empty value to seed demo data on startup. Defaults on so a
# fresh clone has a discoverable account and example sites; the seeder refuses
# to run against any non-localhost APP_ORIGIN, so this is safe to leave on in
# the example file. Set to empty in production. Seeded credentials are
# demo@protopen.dev / protopen-demo (sign in via the dashboard).
SEED_DEMO=1

# Deploy thumbnails — THUMBNAILS_ENABLED makes the feature available on this
# server (set to any non-empty value). Whether captures actually run is then
# controlled by the admin UI under Admin → Settings, persisted in the DB. On
# first boot the runtime state defaults to "on" if env is set, "off" otherwise.
# Requires a Chromium binary at runtime (the protopen Docker image installs it
# automatically; on macOS a normal Google Chrome install is auto-detected).
# Defaulted on here so seeded sites get screenshots out of the box. When
# THUMBNAIL_INTERNAL_TOKEN is empty, an ephemeral one is generated at boot.
# THUMBNAIL_INTERNAL_TOKEN is sent on the X-Protopen-Thumbnail-Token header
# to the content origin so private sites can be captured without a session.
# CHROMIUM_PATH overrides the binary auto-detection (PATH lookup of
# chromium-browser, chromium, google-chrome, google-chrome-stable; on macOS
# also the standard /Applications/Google Chrome.app paths).
THUMBNAILS_ENABLED=1
THUMBNAIL_INTERNAL_TOKEN=
CHROMIUM_PATH=

# Site visibility — DEFAULT_VISIBILITY controls whether newly deployed sites
# start public or private (use "public" or "private"). AUTO_PRIVATE_AFTER_DAYS
# enables the auto-private sweeper when set to an integer 1–3650; public sites
# whose clock is older than this value are flipped back to private during the
# 15-min cleanup tick. Both seed the corresponding instance_settings rows on
# first boot only — after that the admin UI under Admin → Settings is
# authoritative and env changes have no effect.
DEFAULT_VISIBILITY=public
AUTO_PRIVATE_AFTER_DAYS=
