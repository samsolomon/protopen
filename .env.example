# Database — required
DATABASE_URL=postgres://protopen:protopen@localhost:5432/protopen?sslmode=disable

# Server — set PORT for single-server production mode, leave empty for local
# split-server dev (app on APP_LISTEN_ADDR, content on CONTENT_LISTEN_ADDR).
PORT=
APP_LISTEN_ADDR=:8080
CONTENT_LISTEN_ADDR=:8081

# Origins — your protopen instance's public URLs. APP_ORIGIN and
# CONTENT_ORIGIN are the canonical hosts checked against incoming requests
# in production; leave empty in local dev. PUBLIC_CONTENT_URL is where
# live sites are served from (your wildcard subdomain or r2.dev URL).
APP_ORIGIN=
CONTENT_ORIGIN=
PUBLIC_CONTENT_URL=http://127.0.0.1:8081
FRONTEND_ORIGIN=http://localhost:5173

# Cookie domain for the protopen_session cookie. Set in production to your
# apex domain (e.g. .example.com) so the cookie spans app/content subdomains.
# Leave empty for local dev.
COOKIE_DOMAIN=

# Cloudflare R2 — empty R2_BUCKET_NAME falls back to local-filesystem
# storage at INGEST_ROOT. Set all four to use R2.
R2_BUCKET_NAME=
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=

# Local filesystem storage (used when R2 is not configured).
INGEST_ROOT=.data/ingest

# Resend (transactional email) — empty RESEND_API_KEY disables email entirely;
# auth still works (it's password-based, not magic-link). RESEND_FROM_ADDRESS
# must be a domain you've verified in Resend.
RESEND_API_KEY=
RESEND_FROM_ADDRESS=

# Comma-separated list of email addresses granted admin access in the UI.
ADMIN_EMAILS=

# Trusted proxy header for client-IP resolution in rate limiting. Leave empty
# (default) to use the connection remote-addr — correct for bare-VM
# deployments. Behind Cloudflare set CF-Connecting-IP. Behind a reverse proxy
# that strips client-supplied X-Forwarded-For set X-Forwarded-For. Only set
# this if your proxy guarantees the header is not attacker-controllable;
# otherwise clients can spoof their IP to bypass rate limits.
TRUSTED_PROXY_HEADER=

# Set to any non-empty value to seed demo data on startup. Useful for local
# dev; leave empty in production. Seeded credentials are demo@protopen.dev /
# protopen-demo (sign in via the dashboard).
SEED_DEMO=
