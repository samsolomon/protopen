# Database (Railway provides DATABASE_URL automatically)
DATABASE_URL=postgres://protopen:protopen@localhost:5432/protopen?sslmode=disable

# Server (set PORT for single-server production mode, or use split mode for local dev)
PORT=                           # Production: Railway sets this. Empty = local dev split mode.
APP_LISTEN_ADDR=:8080           # Local dev: app server port
CONTENT_LISTEN_ADDR=:8081       # Local dev: content server port

# Origins
APP_ORIGIN=https://app.protopen.dev
CONTENT_ORIGIN=https://sites.protopen.dev
PUBLIC_CONTENT_URL=https://sites.protopen.dev
FRONTEND_ORIGIN=https://app.protopen.dev

# Cloudflare R2 (empty = use local filesystem)
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET_NAME=

# Email via Resend (empty = email disabled, sends logged only)
RESEND_API_KEY=
RESEND_FROM_ADDRESS=Protopen <noreply@protopen.dev>

# Local filesystem storage (used when R2 is not configured)
INGEST_ROOT=.data/ingest
